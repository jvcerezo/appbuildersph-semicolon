{
  "name": "linaw",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @linaw/web dev",
    "dev:overlay": "pnpm --parallel --filter @linaw/web --filter @linaw/desktop run dev",
    "dev:demo": "pnpm --parallel --filter @linaw/web --filter @linaw/desktop --filter @linaw/demo-backend run dev",
    "demo": "pnpm --filter @linaw/demo-backend start",
    "conformance": "pnpm --filter @linaw/conformance start",
    "backend": "pnpm --filter @linaw/backend start",
    "stt": "pnpm --filter @linaw/stt start",
    "stt:setup": "pnpm --filter @linaw/stt setup",
    "dev:backend": "pnpm --parallel --filter @linaw/web --filter @linaw/stt --filter @linaw/backend run dev",
    "dev:overlay:backend": "pnpm --parallel --filter @linaw/web --filter @linaw/desktop --filter @linaw/stt --filter @linaw/backend run dev",
    "validate": "pnpm -r validate",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @linaw/web build",
    "check": "pnpm typecheck && pnpm validate && pnpm build"
  }
}
