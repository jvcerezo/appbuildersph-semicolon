# Server
# bind address for uvicorn
HOST=127.0.0.1
# http://HOST:PORT/ serves the test page
PORT=8000
# Soniox (online engine)
# long-lived key; server-side only, never sent to the browser
SONIOX_API_KEY=
SONIOX_TEMP_KEY_URL=https://api.soniox.com/v1/auth/temporary-api-key
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
# real-time model name
SONIOX_MODEL=stt-rt-v5
# comma-separated language hints
SONIOX_LANGUAGE_HINTS=en,tl
# how long a temp key may be used to open a stream
SONIOX_TEMP_KEY_TTL_SECONDS=60
# max length of one Soniox stream (4 h)
SONIOX_MAX_SESSION_SECONDS=14400
# Text-to-speech (read-aloud), same key as above. mp3 | wav | opus | aac | flac | pcm_s16le | ...
SONIOX_TTS_URL=https://tts-rt.soniox.com/tts
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_TTS_VOICE=Adrian
SONIOX_TTS_AUDIO_FORMAT=mp3
SONIOX_TTS_TIMEOUT_SECONDS=10
# Mode
# auto | soniox | local | local_only (the page dropdown can override)
# local_only: the backend refuses every cloud call (no connectivity check, no temp key)
STT_MODE=auto
# backend probes this to decide online/offline
CONNECTIVITY_CHECK_URL=https://api.soniox.com
CONNECTIVITY_TIMEOUT_SECONDS=2
# Local engine selection (existing chunked engine = "chunked")
# whisperlivekit = real-time partials (primary) | chunked = 5 s windows | mlx-whisper = chunked on Apple Silicon
LOCAL_STT_ENGINE=whisperlivekit
# Chunked engine (offline): settings below apply when LOCAL_STT_ENGINE=chunked
# tiny | base | small | medium | large-v3 | turbo, or a path to a model dir
WHISPER_MODEL=small
# where scripts/download_models.py puts models; loaded with local_files_only
WHISPER_MODEL_DIR=./models
# auto | cpu | cuda (also used for the WhisperLiveKit encoder)
WHISPER_DEVICE=auto
# int8 | int8_float16 | float16 | float32 (also used for the WhisperLiveKit encoder)
WHISPER_COMPUTE_TYPE=int8
# empty = auto-detect per window; "tl" or "en" to force
WHISPER_LANGUAGE=
# window length per inference
LOCAL_CHUNK_SECONDS=5
# overlap between windows (de-duplicated)
LOCAL_CHUNK_OVERLAP_SECONDS=0.5
# WhisperLiveKit (primary local, real-time)
# multilingual model only (no ".en"): tiny | base | small | medium | large-v3 | turbo
WLK_MODEL=small
# simulstreaming (lowest latency) | localagreement
WLK_BACKEND=simulstreaming
# empty = auto-detect; "tl" or "en" to force
WLK_LANGUAGE=
# speaker labels; needs extra diarization models, keep false for the offline demo
WLK_DIARIZATION=false
# where scripts/download_models.py puts the WhisperLiveKit encoder + decoder weights
WLK_MODEL_CACHE_DIR=./models
# true = run inside this server (recommended) | false = local subprocess on WLK_PORT
WLK_EMBEDDED=true
WLK_PORT=8001
# Cloud meter
# Comparison figure we fill in ourselves: what one hour of cloud-only transcription
# would cost (USD per hour). Used only for the on-screen "Cloud-only estimate".
CLOUD_COST_PER_HOUR_ESTIMATE=0
