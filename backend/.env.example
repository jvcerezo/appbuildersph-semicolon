# Copy to .env and change what you need. Every URL must point at this computer.

# WebSocket port the UI connects to.
LINAW_PORT=8765

# ffmpeg decodes the browser's audio. Leave as "ffmpeg" if it's on your PATH.
FFMPEG_PATH=ffmpeg

# whisper.cpp's whisper-server: speech to text.
WHISPER_URL=http://127.0.0.1:8178
# en, tl, or auto (detect per clip).
WHISPER_LANGUAGE=en

# Ollama writes the explanations. Any model you've pulled works.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
