# Copy to .env and change what you need. Every URL must point at this computer.

# WebSocket port the UI connects to.
LINAW_PORT=8765

# ffmpeg decodes the browser's audio. Leave as "ffmpeg" if it's on your PATH.
FFMPEG_PATH=ffmpeg

# Speech to text.
#   service: the speech service in stt/ (pnpm stt). Soniox when online, local Whisper when not.
#   whisper-server: whisper.cpp only (settings below).
STT=service
STT_URL=http://127.0.0.1:8000

# whisper.cpp's whisper-server, when STT=whisper-server.
WHISPER_URL=http://127.0.0.1:8178
# en, tl, or auto (detect per clip).
WHISPER_LANGUAGE=en

# Ollama writes the explanations. Any model you've pulled works.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
