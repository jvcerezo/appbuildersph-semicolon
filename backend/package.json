{
  "name": "@linaw/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Linaw's local backend: hears the hearing with whisper.cpp and explains terms with Ollama, over the contract.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "replay": "tsx scripts/replay.ts",
    "validate": "tsx scripts/validate-glossary.ts && tsx scripts/check-finder.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build-law": "tsx scripts/build-law.ts",
    "draft-cards": "tsx scripts/draft-cards.ts"
  },
  "dependencies": {
    "@linaw/contract": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "~5.6.3"
  }
}
